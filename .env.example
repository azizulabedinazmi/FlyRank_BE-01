# Copy this file to .env and change the password:   cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# Used by the db container on its FIRST start (when the volume is empty) to create the user and database.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks

# Used by the app when you run it on your machine (uvicorn main:app) against the db container's published port.
# Inside docker compose the api service overrides this to point at host "db" instead of localhost.
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/tasks

# Stretch: Redis (pinged on startup and by /health). Overridden to redis://redis:6379/0 inside compose.
REDIS_URL=redis://localhost:6379/0

# ---- A17: POST /tasks/triage (LLM) -------------------------------------------------------------------------
# Three values are the whole provider. Local Ollama (free, no key):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b
# ...or hosted OpenRouter (free tier: needs a key and the two privacy switches, see README):
#   LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_API_KEY=<your key>   LLM_MODEL=openrouter/free
# Inside docker compose the api container uses this one instead (localhost there is the container itself):
LLM_DOCKER_BASE_URL=http://host.docker.internal:11434/v1

# 1 = never call the model, return a fixed schema-valid answer (for building and testing)
LLM_STUB=0
# Kill switch: false = never call the model, return a safe deterministic fallback
LLM_ENABLED=true
# Seconds per model request (the SDK default would be 10 minutes)
LLM_TIMEOUT_S=30
# Total seconds for all attempts of one call, retries and backoff included
LLM_DEADLINE_S=60
