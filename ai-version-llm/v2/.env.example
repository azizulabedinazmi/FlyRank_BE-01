# OpenAI-compatible server (Ollama). Use 127.0.0.1, not localhost (IPv6-first delay on Windows).
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Ollama ignores the key, but the SDK needs a non-empty value.
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# 1 = return a fixed valid answer without calling the model.
LLM_STUB=0
# false = kill switch: return a safe fallback answer, never call the model.
LLM_ENABLED=true
