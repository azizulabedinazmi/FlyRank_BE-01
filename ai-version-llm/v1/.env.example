# OpenAI-compatible server (Ollama exposes one at /v1)
LLM_BASE_URL=http://localhost:11434/v1
# Ollama ignores the key, but the client needs a non-empty value
LLM_API_KEY=ollama
LLM_MODEL=llama3.1

# LLM_STUB=1 returns a fixed valid answer without calling the model
LLM_STUB=0
# LLM_ENABLED=false is the kill switch: returns a safe fallback, no model call
LLM_ENABLED=true

# Optional tuning
LLM_TIMEOUT_SECONDS=20
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE_SECONDS=0.5
