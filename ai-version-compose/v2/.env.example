# Copy this file to .env and change the password. Never commit .env.

# Used by the postgres container to create the database on first start.
POSTGRES_USER=tasks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks

# Used by the app when you run "uvicorn main:app" on your machine (database published on localhost).
# Inside docker compose this is overridden so the app reaches the database at host "db".
# Keep the user/password/db here in sync with the values above. If the password contains
# characters like @ : / ? # %, URL-encode them here (e.g. @ -> %40).
DATABASE_URL=postgresql://tasks:change-me@localhost:5432/tasks
